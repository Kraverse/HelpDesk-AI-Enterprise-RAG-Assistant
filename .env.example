# Server-side OpenRouter credentials; never commit a real value.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=1

# Optional, only configure after verifying the official assistant URL.
ASK_KRAVERSE_URL=

MAX_QUESTION_CHARS=1000
MAX_CHAT_MESSAGES=40
MAX_SESSION_CHARS=30000
SESSION_REQUESTS_PER_MINUTE=20
MAX_L2_DISTANCE=1.5
TOP_K=3
MAX_UPLOAD_FILE_MB=10
MAX_UPLOAD_DOCUMENTS=20
