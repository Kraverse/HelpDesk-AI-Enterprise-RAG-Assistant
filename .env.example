# Provider credentials are secrets. Keep this file as a template only.
NVIDIA_API_KEY=
# Set NVIDIA_MODEL to the exact model ID confirmed for your NVIDIA account.
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_MAX_RETRIES=1

# Optional, only configure after verifying the official assistant URL.
ASK_KRAVERSE_URL=

MAX_QUESTION_CHARS=1000
MAX_CHAT_MESSAGES=40
MAX_SESSION_CHARS=30000
SESSION_REQUESTS_PER_MINUTE=20
MAX_L2_DISTANCE=1.5
TOP_K=3
